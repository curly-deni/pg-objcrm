{
  "name": "objcrm",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:api": "node --env-file=.env.local --test tests/api.test.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "local:configure": "node scripts/configure-local.mjs",
    "demo:seed": "node --env-file=.env.local scripts/seed-demo.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.{mjs,js}\" \"tests/**/*.mjs\" \"supabase/**/*.sql\" \".github/workflows/*.{yml,yaml}\" \"*.{md,json,ts,html,yml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.{mjs,js}\" \"tests/**/*.mjs\" \"supabase/**/*.sql\" \".github/workflows/*.{yml,yaml}\" \"*.{md,json,ts,html,yml}\"",
    "dev:local": "node scripts/dev-local.mjs",
    "local:reset": "node scripts/reset-local.mjs",
    "demo:configure": "node scripts/configure-demo.mjs"
  },
